# Unanchored: cargo puts a `target/` under every package root, not only the repo
# root — fuzz/ gets its own.
target/
.DS_Store

# The derived index is REBUILT from committed markdown by `peira index` and is
# never authoritative. Committing it would create a second source of truth and
# would let a CI gate pass on bytes nobody reviewed.
*.peira-index
index.sqlite
index.sqlite-*

# Coverage output — derived, like the index.
lcov.info

# serena's per-project index and config — a tool's local state, not the project's.
.serena/

# libFuzzer crash reproducers. A crash worth keeping becomes a named unit test
# with the input inline, not an opaque blob nobody can read the significance of.
fuzz/artifacts/

# `fuzz/corpus/` IS committed: the seeds there are the real vault fixtures, and a
# fuzz run that starts from nothing spends its budget rediscovering YAML. Local
# runs will drop coverage-increasing inputs alongside them — commit those only
# when they are worth the review.
